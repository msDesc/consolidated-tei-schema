<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_odds.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_odds.rng" type="application/xml"
	schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron">
   <teiHeader>
      <fileDesc>
         <titleStmt>
            <title>MMOL customizations for msDesc schema</title>
         </titleStmt>
         <publicationStmt>
            <p>Publication Information</p>
         </publicationStmt>
         <sourceDesc>
            <p>Information about the source</p>
         </sourceDesc>
      </fileDesc>
       <revisionDesc>
           <change when="2026-05">Further refinements to encoding for binding descriptions.</change>
       </revisionDesc>
   </teiHeader>
   <text>
      <body>
         <schemaSpec ident="msdescmedieval" source="https://raw.githubusercontent.com/msDesc/consolidated-tei-schema/refs/heads/master/msdesc.compiled.xml" start="TEI" prefix="tei_" targetLang="en" docLang="en">
            <moduleRef key="tei"/>
            <!-- core module -->
            <moduleRef key="core"/>
            <!-- figures module -->
            <moduleRef key="figures"/>
            <!-- header module -->
            <moduleRef key="header"/>
            <!-- linking module -->
            <moduleRef key="linking"/>
            <!-- msdescription module -->
            <moduleRef key="msdescription"/>
            <!-- namesdates module -->
            <moduleRef key="namesdates" />
            <!-- textstructure module -->
            <moduleRef key="textstructure"/>
            <!-- transcr module -->
            <moduleRef key="transcr"/>
            
             <moduleSpec ident="msdesc" mode="add"/>
            
            <elementSpec ident="dimensions" module="msdescription" mode="change">
               <attList>
                  <!-- 2025-6 redefine usage of scope -->
                  <attDef ident="scope" mode="change">
                     <desc>Specifies the extent to which the dimensions described are typical of the manuscript or codicological unit as a whole. Note: This is a customization which is not currently
                        part of the TEI P5 standard.</desc>
                     <valList mode="replace" type="closed">
                        <valItem ident="sole">
                           <desc>The dimensions are typical of the whole manuscript or codicological unit.</desc>
                        </valItem>
                        <valItem ident="major">
                           <desc>The dimensions are typical of the majority of the manuscript or codicological unit.</desc>
                        </valItem>
                        <valItem ident="minor">
                           <desc>The dimensions are typical of a small part of the manuscript or codicological unit.</desc>
                        </valItem>
                     </valList>
                  </attDef>
                  
               </attList>
            </elementSpec>
            
            <!-- add scope attribute to layout element -->
            <elementSpec ident="layout" module="msdescription" mode="change">
               <attList>
                  <attDef ident="scope" mode="add">
                     <desc>Specifies the extent to which the layout described is typical of the manuscript or codicological unit as a whole. Note: This is a customization which is not currently
                        part of the TEI P5 standard.</desc>
                     <valList type="closed">
                        <valItem ident="sole">
                           <desc>Only this layout is used.</desc>
                        </valItem>
                        <valItem ident="major">
                           <desc>This layout is used through most of the manuscript or codicological unit.</desc>
                        </valItem>
                        <valItem ident="minor">
                           <desc>This layout is used occasionally through the manuscript or codicological unit.</desc>
                        </valItem>
                        
                     </valList>
                  </attDef>
                
               </attList>
            </elementSpec>
            
            
            
            <!-- changes to bindingDesc -->
             
             
                    <!-- possible schema rules
                    
                    structure: only if first binding or rebinding?
                    
                    -->
             
             
             
             
             <elementSpec ident="bindingDesc" mode="change">
                 <content>
                     
                     <alternate>
                         <sequence><elementRef key="summary" maxOccurs="1"/>
                             <elementRef key="binding" minOccurs="1" maxOccurs="unbounded" /></sequence>
                         
                         <alternate><classRef key="model.pLike" maxOccurs="unbounded"/>
                             <elementRef key="decoNote" />
                             <elementRef key="condition" />
                             <elementRef key="binding" /></alternate>
                         
                         
                         
                     </alternate>
                 </content>
             </elementSpec>
             
             
            <elementSpec ident="binding" module="msdescription" mode="change">
               <classes mode="change">
                  <memberOf key="att.typed"/>
               </classes>
               <content>
                   
                   <alternate>
                      
                       
                       <!-- TEI P5: allow any combination of p, decoNote, condition -->
                       <alternate><classRef key="model.pLike" maxOccurs="unbounded"/>
                           <elementRef key="decoNote" />
                           <elementRef key="condition" /></alternate>
                       
                       
                       <!-- MMOL -->
                  <alternate maxOccurs="unbounded" minOccurs="0" >
                     <!--<classRef key="model.noteLike"/>-->
                      <elementRef key="head"/>
                    <!-- <elementRef key="p"/>-->
                     
                   <!--  
                     <elementRef key="dimensions"/>
                    
                     <elementRef key="summary"/>-->
                      <elementRef key="history" />
                      <elementRef key="endleaves"  />
                      <elementRef key="sewing"  />
                      <elementRef key="boards" />
                      <elementRef key="edges" />
                      <elementRef key="spine"  />
                    
                      <elementRef key="endbands"  />
                      <elementRef key="covering" />
                      <elementRef key="decoNote" />
                      <elementRef key="fastenings" />
                      <elementRef key="furniture" />
                      <elementRef key="tacketing"  />
                      <elementRef key="alterations"  />  
                      <elementRef key="bookmarks"  /> 
                      <elementRef key="curtains"   />
                      <elementRef key="chaining"   />
                   
                      <elementRef key="labels"  />
                    
                  </alternate>
                   
                    </alternate>
               </content>
               <constraintSpec ident="binding.check" scheme="schematron">
                  <constraint>
                     <sch:rule context="//tei:binding">
                        <sch:assert
                           test="@when or @notBefore or @notAfter or @contemporary='true'"
                           role="warn"> The binding element should have dating
                           attributes (when or notBefore/notAfter) or a contemporary
                           attribute (with the value 'true'). </sch:assert>
                     </sch:rule>
                  </constraint>
               </constraintSpec>
               <attList>
                  <attDef ident="type" mode="change">
                     <desc xml:lang="en">Classifies the general
                        structure of the binding.</desc>
                     <valList type="semi" mode="change">
                        <valItem mode="add" ident="limp"/>
                        <valItem mode="add" ident="inboard"/>
                        <valItem mode="add" ident="case"/>
                        <valItem mode="add" ident="stiched"/>
                     </valList>
                  </attDef>
                  <attDef ident="subtype" mode="change">
                      <desc xml:lang="en">Describes whether the binding is a first binding, a rebinding, or an alteration.</desc>
                      <valList type="closed" mode="change">
                          <valItem mode="add" ident="firstBinding"><desc>The binding being described is the first binding.</desc></valItem>
                          <valItem mode="add" ident="rebinding"><desc>The binding described is a rebinding, with new sewing, that may preserve other components of earlier bindings.</desc></valItem>
                          <valItem mode="add" ident="alteration"><desc>The binding described is an alteration of an earlier binding (usually meaning that the sewing of an earlier binding is preserved)</desc></valItem>
                      </valList>
                  </attDef>
                  <attDef ident="structure" mode="add">
                      <desc versionDate="2024-01-23" xml:lang="en">Provides a broad
                        classification of inboard structures</desc>
                     <valList type="closed" mode="change">
                        <valItem mode="add" ident="romanesque"/>
                        <valItem mode="add" ident="gothic"/>
                        <valItem mode="add" ident="earlyMedieval"/>
                        <valItem mode="add" ident="lacedCase"/>
                        <valItem mode="add" ident="greek"/>
                        <valItem mode="add" ident="wrapper"/>
                     </valList>
                  </attDef>
               </attList>
            </elementSpec>
             
             
             <!-- changes to decoNote element -->
             <elementSpec ident="decoNote" module="msdescription" mode="change">
                 <attList>
                     <attDef ident="type" mode="change">
                         <valList mode="replace" type="semi">
                             <valItem ident="border">
                                 <desc>The decoration note concerns the border(s)</desc>
                             </valItem>
                             <valItem ident="diagram">
                                 <desc>The decoration note concerns the diagram(s)</desc>
                             </valItem>
                             <valItem ident="illustration">
                                 <desc>The decoration note concerns the
                                     illustration(s)</desc>
                             </valItem>
                             <valItem ident="initial">
                                 <desc>The decoration note concerns the initial(s)</desc>
                             </valItem>
                             <valItem ident="marginal">
                                 <desc>The decoration note concerns the marginal
                                     decoration</desc>
                             </valItem>
                             <valItem ident="micrography">
                                 <desc>The decoration note concerns the micrography</desc>
                             </valItem>
                             <valItem ident="miniature">
                                 <desc>The decoration note concerns miniature(s) or coloured drawings</desc>
                             </valItem>
                             <valItem ident="drawing">
                                 <desc>The decoration note concerns (uncoloured) drawings or sketches</desc>
                             </valItem>
                             <valItem ident="rubrication">
                                 <desc>The decoration note concerns the rubrication or other
                                     highlighting</desc>
                             </valItem>
                             
                             <!-- add value lists for medieval -->
                             <valItem ident="bas-de-page">
                                 <desc>The decoration note concerns bas-de-page scenes </desc>
                             </valItem>
                             <valItem ident="map">
                                 <desc>The decoration note concerns a map or maps</desc>
                             </valItem>
                             <valItem ident="headpiece">
                                 <desc>The decoration note concerns a headpiece</desc>
                             </valItem>
                             
                             <valItem ident="canonTable">
                                 <desc>The decoration note concerns canon table(s)</desc>
                             </valItem>
                             <valItem ident="carpetPage">
                                 <desc>The decoration note concerns so-called carpet page(s)</desc>
                             </valItem>
                             
                             <valItem ident="histInit">
                                 <desc>The decoration note concerns historiated initials</desc>
                             </valItem>
                             <valItem ident="decInit">
                                 <desc>The decoration note concerns decorated (but not historiated) initials</desc>
                             </valItem>
                             
                             <valItem ident="flourInit">
                                 <desc>The decoration note concerns pen-work flourishing of letters and/or borders</desc>
                             </valItem>
                             
                             <valItem ident="colInit">
                                 <desc>The decoration note concerns coloured (but not decorated or flourished) initials</desc>
                             </valItem>
                             
                             <valItem ident="plainInit">
                                 <desc>The decoration note concerns plain initials (in the ink of the text)</desc>
                             </valItem>
                             
                             <valItem ident="chrysography">
                                 <desc>The decoration note concerns chrysography (writing in gold)</desc>
                             </valItem>
                             <valItem ident="lineFill">
                                 <desc>The decoration note concerns line fillers</desc>
                             </valItem>
                             <valItem ident="cadel">
                                 <desc>The decoration note concerns cadels</desc>
                             </valItem>
                             <valItem ident="instructions">
                                 <desc>The decoration note concerns intructions for decoration</desc>
                             </valItem>
                             <valItem ident="unfilled">
                                 <desc>The decoration note concerns space for decoration left unfilled</desc>
                             </valItem>
                             <valItem ident="none">
                                 <desc>The decoration note records the absence of any decoration</desc>
                             </valItem>
                             
                             <valItem ident="other">
                                 <desc>The decoration note concerns other/unspecified aspects
                                     (you may also provide a custom value)</desc>
                             </valItem>
                             
                             <!-- new values for bindings -->
                             <!-- blind-tooled, gold-tooled, cut leather, embroidered, other -->
                             <valItem ident="blindTooled">
                                 <desc>The decoration note concerns a blind-tooled binding</desc>
                             </valItem>
                             <valItem ident="goldTooled">
                                 <desc>The decoration note concerns a gold-tooled binding</desc>
                             </valItem>
                             <valItem ident="cutLeather">
                                 <desc>The decoration note concerns a cut-leather binding</desc>
                             </valItem>
                             <valItem ident="embroidered">
                                 <desc>The decoration note concerns an embroidered binding</desc>
                             </valItem>
                             <valItem ident="unknown">
                                 <desc>The decoration note concerns a binding without evidence for the presence, absence or type of decoration</desc>
                             </valItem>
                         </valList>
                     </attDef>
                 </attList>
             </elementSpec>

             <elementSpec ident="endleaves" ns="http://www.example.org/ns/msdesc" mode="add"
                        module="msdesc">
                        <classes>
                            <memberOf key="att.typed"/>
                        </classes>
                        <content>
                            <macroRef key="macro.specialPara"/>
                        </content>
                        <attList>
                            <attDef ident="support" usage="opt">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="perg"/>
                                    <valItem ident="chart"/>
                                </valList>
                            </attDef>
                           
                           <attDef ident="type" mode="change">
                              <desc xml:lang="en">Classifies the 
                                 type of endleaf structure.</desc>
                              <valList type="semi" mode="change">
                                 <valItem mode="add" ident="separate"/>
                                 <valItem mode="add" ident="integral"/>
                              </valList>
                           </attDef>
                           <attDef ident="subtype" mode="change">
                              <desc xml:lang="en">Describes whether or not the endleaf material is reused.</desc>
                              <valList type="semi" mode="change">
                                 <valItem mode="add" ident="firstUse"/>
                                 <valItem mode="add" ident="reused"/>
                                 <valItem mode="add" ident="mixed"/>
                              </valList>
                           </attDef>
                            <attDef ident="status">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="extant"/>
                                    <valItem ident="partiallyExtant"/>
                                    <valItem ident="lost"/>
                                    <valItem ident="unknown"/>
                                    <valItem ident="none"/>
                                </valList>
                            </attDef>
                        </attList>
                    </elementSpec>

             <elementSpec ident="sewing" ns="http://www.example.org/ns/msdesc" mode="add"
                        module="msdesc">
                        <classes/>
                        <content>
                            <macroRef key="macro.specialPara"/>
                        </content>
                        <attList>
                            <attDef ident="sewing" usage="opt">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="supported"/>
                                    <valItem ident="unsupported"/>
                                </valList>
                            </attDef>
                            <attDef ident="supports" usage="opt">
                                <datatype>
                                    <dataRef name="nonNegativeInteger"/>
                                </datatype>
                            </attDef>
                            <attDef ident="status">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="extant"/>
                                    <valItem ident="partiallyExtant"/>
                                    <valItem ident="lost"/>
                                    <valItem ident="unknown"/>
                                    <valItem ident="none"/>
                                </valList>
                            </attDef>
                        </attList>
                    </elementSpec>

             <elementSpec ident="edges" ns="http://www.example.org/ns/msdesc" mode="add"
                        module="msdesc">
                        <classes/>
                        <content>
                            <macroRef key="macro.specialPara"/>
                        </content>
                 <attList>
                     <attDef ident="decoration" usage="opt">
                         <datatype>
                             <dataRef name="string"/>
                         </datatype>
                         <valList type="semi">
                             <valItem ident="coloured"/>
                             <valItem ident="marbled"/>
                             <valItem ident="sprinkled"/>
                             <valItem ident="pasteDecorated"/>
                             <valItem ident="gilded"/>
                             <valItem ident="gauffered"/>
                             <valItem ident="painted"/>
                             <valItem ident="none"/>
                         </valList>
                     </attDef>
                    
                 </attList>
                    </elementSpec>
             
             
             <elementSpec ident="spine" ns="http://www.example.org/ns/msdesc" mode="add"
                        module="msdesc">
                        <classes/>
                        <content>
                            <macroRef key="macro.specialPara"/>
                        </content>
                 <attList>
                     <attDef ident="profile" usage="opt">
                         <datatype>
                             <dataRef name="string"/>
                         </datatype>
                         <valList type="semi">
                             <valItem ident="flat"/>
                             <valItem ident="rounded"/>
                         </valList>
                     </attDef>
                     <attDef ident="status">
                         <datatype>
                             <dataRef name="string"/>
                         </datatype>
                         <valList type="semi">
                             <valItem ident="extant"/>
                             <valItem ident="partiallyExtant"/>
                             <valItem ident="lost"/>
                             <valItem ident="unknown"/>
                             <valItem ident="none"/>
                         </valList>
                     </attDef>
                 </attList>
                    </elementSpec>

             <elementSpec ident="boards" ns="http://www.example.org/ns/msdesc" mode="add"
                        module="msdesc">
                        <classes/>
                        <content>
                            <macroRef key="macro.specialPara"/>
                        </content>
                        <attList>
                            <attDef ident="material">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="chart">
                                        <desc versionDate="2024-01-24" xml:lang="en">The boards are
                                            composed of paper
                                            (https://www.ligatus.org.uk/lob/concept/4168)</desc>
                                    </valItem>
                                    <valItem ident="wood">
                                        <desc versionDate="2024-01-24" xml:lang="en">The boards are
                                            composed of wood
                                            (https://www.ligatus.org.uk/lob/concept/3699)</desc>
                                    </valItem>
                                </valList>
                            </attDef>
                            <attDef ident="squares">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="true"/>
                                    <valItem ident="false"/>
                                    <valItem ident="unknown"/>
                                </valList>
                            </attDef>
                            <attDef ident="reused">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList>
                                    <valItem ident="true"/>
                                    <valItem ident="false"/>
                                    <valItem ident="unknown"/>
                                </valList>
                            </attDef>
                            <attDef ident="status">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="extant"/>
                                    <valItem ident="partiallyExtant"/>
                                    <valItem ident="lost"/>
                                    <valItem ident="unknown"/>
                                    <valItem ident="none"/>
                                </valList>
                            </attDef>
                        </attList>
                    </elementSpec>
             
             
                    <elementSpec ident="endbands" ns="http://www.example.org/ns/msdesc" mode="add"
                        module="msdesc">
                       <classes>
                          <memberOf key="att.typed"/>
                       </classes>
                        <content>
                            <macroRef key="macro.specialPara"/>
                        </content>
                       <attList>
                           <attDef ident="type" mode="change">
                          <desc xml:lang="en">Classifies the endband as primary, compound, or stuck on.</desc>
                          <valList type="semi" mode="change">
                             <valItem mode="add" ident="primary"/>
                             <valItem mode="add" ident="compound"/>
                             <valItem mode="add" ident="stuckOn"/>
                          </valList>
                       </attDef>
                           <attDef ident="subtype" mode="change">
                          <desc xml:lang="en">Classifies the endband as structural or non-structural.</desc>
                          <valList type="semi" mode="change">
                             <valItem mode="add" ident="structural"/>
                             <valItem mode="add" ident="nonStructural"/>
                          </valList>
                       </attDef>
                           <attDef ident="status">
                               <datatype>
                                   <dataRef name="string"/>
                               </datatype>
                               <valList type="semi">
                                   <valItem ident="extant"/>
                                   <valItem ident="partiallyExtant"/>
                                   <valItem ident="lost"/>
                                   <valItem ident="unknown"/>
                                   <valItem ident="none"/>
                               </valList>
                           </attDef>
                       </attList>
                        
                    </elementSpec>
             
             
                    <elementSpec ident="covering" ns="http://www.example.org/ns/msdesc" mode="add"
                        module="msdesc">
                        <classes/>
                        <content>
                            <macroRef key="macro.specialPara"/>
                        </content>
                        <attList>
                            <attDef ident="type" usage="opt">
                                <datatype>
                                    <dataRef key="teidata.enumerated"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="primary"/>
                                    <valItem ident="secondary"/>
                                    <valItem ident="foreedgeFlap"/>
                                    <valItem ident="overback"/>
                                    <valItem ident="wrapper"/>
                                </valList>
                            </attDef>
                            <attDef ident="extent">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="full">
                                        <desc versionDate="2024-01-24" xml:lang="en">"The covering
                                            material extends around the spine from fore-edge to
                                            fore-edge. A full cover can, but does not always, have
                                            turn-ins."
                                            (https://www.ligatus.org.uk/lob/concept/1348)</desc>
                                    </valItem>
                                    <valItem ident="half">
                                        <desc versionDate="2024-01-24" xml:lang="en">"A part cover
                                            in which the spine and the back edge of the boards are
                                            covered in one material and the outer corners of the
                                            boards are covered with pieces of either the same or a
                                            different
                                            material."(https://www.ligatus.org.uk/lob/concept/1382)</desc>
                                    </valItem>
                                    <valItem ident="quarter">
                                        <desc versionDate="2024-01-24" xml:lang="en">"Quarter covers
                                            are those which cover only the spine and the back edge
                                            of the boards."
                                            (https://www.ligatus.org.uk/lob/concept/1530)</desc>
                                    </valItem>
                                    <valItem ident="none">
                                        <desc versionDate="2024-01-24" xml:lang="en">The boards are
                                            not covered.</desc>
                                    </valItem>
                                </valList>
                            </attDef>
                            <attDef ident="material">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="skinTawed">
                                        <desc versionDate="2024-01-24" xml:lang="en">The covering is
                                            alum-tawed skin
                                            (https://www.ligatus.org.uk/lob/concept/1197)</desc>
                                    </valItem>
                                    <valItem ident="skinTanned">
                                        <desc versionDate="2024-01-24" xml:lang="en">The covering is
                                            tanned skin
                                            (https://www.ligatus.org.uk/lob/concept/1658)</desc>
                                    </valItem>
                                    <valItem ident="perg">
                                        <desc versionDate="2024-01-24" xml:lang="en">The covering is
                                            parchment
                                            (https://www.ligatus.org.uk/lob/concept/1485)</desc>
                                    </valItem>
                                    <valItem ident="chart">
                                        <desc versionDate="2024-01-24" xml:lang="en">The covering is
                                            paper
                                            (https://www.ligatus.org.uk/lob/concept/1481)</desc>
                                    </valItem>
                                    <valItem ident="textile">
                                        <desc versionDate="2024-01-24" xml:lang="en">The covering is
                                            textile
                                            (https://www.ligatus.org.uk/lob/concept/2470)</desc>
                                    </valItem>
                                   <!-- todo: waste? -->
                                </valList>
                            </attDef>
                            <attDef ident="materialUse">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="firstUse">
                                    </valItem>
                                    <valItem ident="reused">
                                    </valItem>
                                </valList>
                            </attDef>
                            <attDef ident="colour">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                            </attDef>
                            <attDef ident="status">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="extant"/>
                                    <valItem ident="partiallyExtant"/>
                                    <valItem ident="lost"/>
                                    <valItem ident="unknown"/>
                                    <valItem ident="none"/>
                                </valList>
                            </attDef>
                        </attList>
                    </elementSpec>
             
                  <!-- decoNote TODO -->
             
             <elementSpec ident="fastenings" ns="http://www.example.org/ns/msdesc" mode="add"
                 module="msdesc">
                        <classes/>
                        <content>
                            <macroRef key="macro.specialPara"/>
                        </content>
                        <attList>
                            <attDef ident="direction">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="closed">
                                    <valItem ident="rtl"/>
                                    <valItem ident="ltr"/>
                                    <valItem ident="unknown"/>
                                </valList>
                            </attDef>
                            <attDef ident="type" usage="opt">
                                <datatype>
                                    <dataRef key="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="tie"/>
                                    <valItem ident="clasp"/>
                                    <valItem ident="strap"/>
                                    <valItem ident="other"/>
                                </valList>
                            </attDef>
                            
                          
                            <attDef ident="status">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="extant"/>
                                    <valItem ident="partiallyExtant"/>
                                    <valItem ident="lost"/>
                                    <valItem ident="unknown"/>
                                    <valItem ident="none"/>
                                </valList>
                            </attDef>
                            
                            <attRef name="quantity" class="att.dimensions"/>
                        </attList>
                    </elementSpec>
            
                    <elementSpec ident="furniture" ns="http://www.example.org/ns/msdesc" mode="add"
                        module="msdesc">
                        <classes>
                            <memberOf key="att.typed"/>
                        </classes>
                        <content>
                            <macroRef key="macro.specialPara"/>
                        </content>
                        <attList>
                            <attDef ident="type" mode="change">
                                <desc xml:lang="en">Classifies the type of furniture.</desc>
                                <valList type="semi" mode="change">
                                    <valItem mode="add" ident="boss"/>
                                    <valItem mode="add" ident="corner"/>
                                    <valItem mode="add" ident="other"/>
                                </valList>
                            </attDef>
                            <attDef ident="status">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="extant"/>
                                    <valItem ident="partiallyExtant"/>
                                    <valItem ident="lost"/>
                                    <valItem ident="unknown"/>
                                    <valItem ident="none"/>
                                </valList>
                            </attDef>
                        </attList>
                    </elementSpec>
            
            
                    <elementSpec ident="chaining" ns="http://www.example.org/ns/msdesc" mode="add"
                        module="msdesc">
                        <desc versionDate="2024-01-23" xml:lang="en">Describes any evidence for
                            chaining of the book.</desc>
                        <classes>
                            <memberOf key="att.datable"/>
                            <!--<memberOf key="att.datable.custom"/>
                            <memberOf key="att.datable.iso"/>
                            <memberOf key="att.datable.w3c"/>-->
                        </classes>
                        <content>
                            <macroRef key="macro.specialPara"/>
                        </content>
                        <attList>
                            <attDef ident="status">
                                <datatype>
                                    <dataRef name="string"/>
                                </datatype>
                                <valList type="semi">
                                    <valItem ident="extant"/>
                                    <valItem ident="partiallyExtant"/>
                                    <valItem ident="lost"/>
                                    <valItem ident="unknown"/>
                                    <valItem ident="none"/>
                                </valList>
                            </attDef>
                        </attList>
                    </elementSpec>
            
            
                    <elementSpec ident="tacketing" ns="http://www.example.org/ns/msdesc" mode="add"
                        module="msdesc">
                        <classes/>
